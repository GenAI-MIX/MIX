66666, 4211.666666666667], [1012.3333333333334, 4242.666666666667], [65.0, 4242.0]], "confidence": 0.9945107102394104, "bbox": [65.0, 4211.0, 1012.6666666666666, 4242.666666666667], "source": "upscaled"}, {"text": "※일간 거래금액은 매수체결금액+매도체결금액으로 계산되며,일간 이벤트 거래조건 충족시 추첨", "quad": [[63.333333333333336, 3990.6666666666665], [1014.3333333333334, 3989.0], [1014.6666666666666, 4025.6666666666665], [63.666666666666664, 4027.6666666666665]], "confidence": 0.9858385920524597, "bbox": [63.333333333333336, 3989.0, 1014.6666666666666, 4027.6666666666665], "source": "upscaled"}, {"text": "있으며,투자상대국가의 시장,정치 및 경제상황 등에 따른 위험 등으로 자산가치의 손실이 발생", "quad": [[94.0, 5054.666666666667], [1014.3333333333334, 5055.333333333333], [1014.0, 5088.666666666667], [94.0, 5088.0]], "confidence": 0.9751600623130798, "bbox": [94.0, 5054.666666666667, 1014.3333333333334, 5088.666666666667], "source": "upscaled"}, {"text": "※본 이벤트의 경품지급에 따른 비용은 NH-Amundi 자산운용에서 전액 부담합니다.", "quad": [[67.0, 4514.666666666667], [891.6666666666666, 4514.666666666667], [891.6666666666666, 4544.666666666667], [67.0, 4544.666666666667]], "confidence": 0.974721372127533, "bbox": [67.0, 4514.666666666667, 891.6666666666666, 4544.666666666667], "source": "upscaled"}, {"text": "※ 본 이벤트는 당사 및 자산운용사 사정에 따라 변경 또는 중단될 수 있습니다.(단,기 조건", "quad": [[66.33333333333333, 4557.0], [926.6666666666666, 4556.333333333333], [926.6666666666666, 4586.333333333333], [66.66666666666667, 4587.0]], "confidence": 0.9711900353431702, "bbox": [66.33333333333333, 4556.333333333333, 926.6666666666666, 4587.0], "source": "upscaled"}, {"text": "SMS(문자메시지)마케팅 동의한 고객 대상으로 지급됩니다.(마케팅 동의 필수)", "quad": [[95.66666666666667, 4167.333333333333], [863.6666666666666, 4166.666666666667], [863.6666666666666, 4199.0], [95.66666666666667, 4199.666666666667]], "confidence": 0.9807474613189697, "bbox": [95.66666666666667, 4166.666666666667, 863.6666666666666, 4199.666666666667], "source": "upscaled"}, {"text": "※증권거래비용,ETF거래수수료 및 기타비용이 추가로 발생할 수 있습니다.", "quad": [[66.33333333333333