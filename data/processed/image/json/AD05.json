    {"id": 11, "type": "risk_notice", "text": "위험등급 2등급(높은 위험)", "bbox": [155, 2778, 506, 2814], "block_ids": [26, 27]},
    {"id": 12, "type": "risk_notice", "text": "*위 상품은 상장 1년 미만 상품으로 총보수(연) 기재", "bbox": [116, 2839, 574, 2869], "block_ids": [28]},
