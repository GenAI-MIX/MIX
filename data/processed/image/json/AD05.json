    {"id": 9, "type": "unknown", "text": "HANARO 글로벌피지컬A 액티브(0040S0) 연0.60% (운용 0.55%,AP/LP 0.01%,신탁 0.02%, 일반사무 0.02%)", "bbox": [116, 2574, 967, 2744], "block_ids": [18, 19, 20, 21, 23, 24, 25]},
