    {"id": 6, "text": "은행 방문없이 전국 18개 제휴 금융사의 맞춤 제안을", "bbox": [1155, 520, 1796, 563], "conf": 0.99, "type": "unknown", "h_px": 30.0, "contrast": 9.3},
    {"id": 7, "text": "론앤비즈로", "bbox": [405, 530, 912, 645], "conf": 1.0, "type": "headline", "h_px": 95.0, "contrast": 10.6},
    {"id": 8, "text": "온라인으로 비교할 수 있습니다", "bbox": [1156, 563, 1560, 604], "conf": 0.96, "type": "unknown", "h_px": 29.0, "contrast": 9.2},
    {"id": 9, "text": "꼭 신한이 아니어도 좋습니다", "bbox": [1153, 634, 1633, 684], "conf": 0.95, "type": "unknown", "h_px": 35.0, "contrast": 2.8},
    {"id": 10, "text": "비교하는 시대", "bbox": [396, 644, 1023, 779], "conf": 1.0, "type": "headline", "h_px": 96.0, "contrast": 12.6},
    {"id": 11, "text": "시니", "bbox": [820, 695, 1000, 758], "conf": 0.97, "type": "unknown", "h_px": 56.7, "contrast": 12.5},
    {"id": 12, "text": "이제,법인 대출은 사장님께서 결정하세요", "bbox": [1155, 684, 1707, 728], "conf": 0.99, "type": "unknown", "h_px": 30.0, "contrast": 9.2},
    {"id": 13, "text": "법인 고객님의 사업 성공을 위해", "bbox": [1155, 756, 1581, 798], "conf": 0.98, "type": "unknown", "h_px": 29.0, "contrast": 9.3},
    {"id": 14, "text": "론앤비즈가 함께 하겠습니다", "bbox": [1154, 798, 1536, 842], "conf": 1.0, "type": "unknown", "h_px": 30.0, "contrast": 9.3},
